# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key
OPENAI_API_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://flying_search_bot_user:change-me@localhost:5432/flying_search_bot

# OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Web search context size: low | medium | high (default: high)
OPENAI_SEARCH_CONTEXT_SIZE=high

# Daily watch schedule
WATCH_SEND_HOUR=9
WATCH_SEND_MINUTE=0
WATCH_TIMEZONE=Europe/Madrid

# Optional: restrict access by Telegram user ID (comma-separated; empty = allow all)
ALLOWED_TELEGRAM_USER_IDS=
